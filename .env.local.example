# Anthropic API key for Claude Haiku transaction categorization
# Get yours at https://console.anthropic.com/
# Without this, unknown merchants are categorized as "Others" (app still works)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: require this password before using the app.
# Set this before enabling Tailscale/private remote access.
# APP_PASSWORD=choose-a-long-password

# Optional: cloud database for Mac-offline access.
# Use these in production hosting, e.g. Vercel + Turso/libSQL.
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# FINANCE_TRACKER_URL=https://your-deployed-app.example.com

# Optional: allow the launchd service to listen on your Tailscale IP.
# Requires APP_PASSWORD. Keep disabled for local-only use.
# ENABLE_TAILSCALE_ACCESS=0
# FINANCE_TRACKER_HOSTNAME=100.x.y.z
# FINANCE_TRACKER_PORT=3000
# FINANCE_TRACKER_NPM_BIN=/opt/homebrew/opt/node@24/bin/npm

# Optional: where database backups should be written.
# FINANCE_BACKUP_DIR=~/Documents/FinanceTracker/backups

# Optional: store the SQLite DB outside the repo, e.g. in a backed-up folder.
# Do not run the app on multiple computers against the same synced DB at the same time.
# FINANCE_DB_PATH=~/Documents/FinanceTracker/finance.db

# Optional: Telegram. The 10pm message goes to TELEGRAM_CHAT_ID, or to the
# group's Daily insights topic once TELEGRAM_GROUP_ID and
# TELEGRAM_INSIGHTS_TOPIC_ID are set.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Ask the finance agent from a Telegram group with topics. Run
# `npm run telegram:setup` to register the webhook and print these ids.
# TELEGRAM_WEBHOOK_SECRET=   # letters, digits, _ and - only
# TELEGRAM_OWNER_ID=
# TELEGRAM_GROUP_ID=
# TELEGRAM_ASK_TOPIC_ID=
# TELEGRAM_INSIGHTS_TOPIC_ID=
# APP_URL=                   # e.g. https://your-app.vercel.app
